# ============================================================================
# The AI School HRM — Environment Configuration Template
# Copy this file to `.env` locally and populate real secrets outside git.
# NEVER commit real service-role keys, secret keys, SMTP passwords, or DB passwords.
# NEVER prefix SMTP credentials with VITE_ (browser-exposed).
# ============================================================================

# Public client configuration (exposed to browser via Vite)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# Server-side Supabase configuration (TanStack Start server functions)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
SUPABASE_SECRET_KEY=sb_secret_<your-secret-key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Direct PostgreSQL connection string (migrations / admin scripts only — DO NOT expose)
DATABASE_URL=postgresql://postgres:<your-db-password>@db.<project-ref>.supabase.co:5432/postgres

# Application URL & Scheduled Hook Security
SITE_URL=https://hrm.theaischool.co
VITE_SITE_URL=https://hrm.theaischool.co
CRON_SECRET=<generate-a-32-byte-random-hex-secret>

# Outbound Email — Hostinger SMTP (Server-Only; NEVER prefix with VITE_)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hr@theaischool.co
SMTP_PASS=<configured-privately-never-commit>
EMAIL_FROM=hr@theaischool.co
EMAIL_FROM_NAME=The AI School HR
EMAIL_REPLY_TO=hr@theaischool.co
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_SEND_TIMEOUT_MS=30000

# Optional Future Inbound Email — Hostinger IMAP (Not active in current phase)
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_SECURE=true
